# 统一换行，避免 Windows/Linux 来回转换造成整文件 diff
* text=auto eol=lf

# 图片与二进制（C# 编译产物、图标、数据库）
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.exe binary
*.dll binary
*.zip binary
*.db binary
*.node binary
*.ttf binary
*.woff2 binary

# 数据文件保持 LF
*.csv text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.prisma text eol=lf
*.css text eol=lf
